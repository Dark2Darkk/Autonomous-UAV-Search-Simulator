<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="basic_world">

    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <box>
              <size>100 100 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>100 100 0.1</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <model name="obstacle">
      <static>true</static>

      <pose>5 0 1 0 0 0</pose>

      <link name="obstacle_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2 2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2 2 2</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

  </world>

</sdf>